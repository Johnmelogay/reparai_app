{
  "expo": {
    "name": "Reparaí Prestador",
    "owner": "nomeconceitual",
    "slug": "reparai-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reparaiprovider",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reparai.provider",
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY}"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos de sua localização para mostrar pedidos próximos e calcular distâncias.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Precisamos de sua localização para atualizar sua posição em tempo real durante o serviço.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "com.reparai.provider",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY}"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos para atualizar o avatar do seu perfil de prestador."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87d11a6b-a341-49ef-99e8-a294a6e92871"
      }
    }
  }
}
